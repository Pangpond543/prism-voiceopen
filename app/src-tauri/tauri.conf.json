{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prism VoiceOpen",
  "version": "1.1.0",
  "identifier": "com.prism.voiceopen",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Prism VoiceOpen",
        "width": 1480,
        "height": 920,
        "minWidth": 1040,
        "minHeight": 680,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "center": true,
        "backgroundColor": "#e9eefc",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: http://pvo.localhost pvo:; media-src 'self' blob: http://pvo.localhost pvo:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
